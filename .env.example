# Copy this file to .env and adjust.
# Local PostgreSQL 16 (see the docker run command in README.md).
# On Neon, paste the connection string it gives you (ends with ?sslmode=require).
DATABASE_URL="postgresql://postgres:secret@localhost:5433/midsalip_leave"

# Used to sign login session cookies. Replace with 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-at-least-32-random-characters"
