# Settings for MMH Leave. "npm run setup" copies this file to .env and fills in the secrets.
# Never share or commit .env.

# ── Database ─────────────────────────────────────────────────
# Address of the PostgreSQL database. The default matches docker-compose.yml
# (user postgres, password "secret", port 5433 on this computer, database midsalip_leave).
# On Neon, paste the connection string it gives you (ends with ?sslmode=require).
DATABASE_URL="postgresql://postgres:secret@localhost:5433/midsalip_leave"

# Optional, read by docker-compose.yml. If you change them, change DATABASE_URL to match.
# POSTGRES_PASSWORD="secret"
# POSTGRES_PORT="5433"
# POSTGRES_CONTAINER="midsalip-postgres"   # also used by npm run db:backup / db:restore
# POSTGRES_VOLUME="midsalip-pgdata"

# ── Security ─────────────────────────────────────────────────
# Signs the login cookies. 32+ random characters (setup fills it in). Changing it signs everyone out.
SESSION_SECRET="replace-me-with-at-least-32-random-characters"

# First password of the starter accounts "hrmo" and "mayor" (setup fills it in; used only
# when the production seed creates them). Delete this line after you changed both passwords.
SEED_ADMIN_PASSWORD="replace-me"

# Optional. Send the login cookie over HTTPS only. Leave it out on the municipal LAN (plain http://),
# or nobody can stay logged in. When left out, it is on only if APP_URL starts with https://.
# COOKIE_SECURE="true"

# ── Display ──────────────────────────────────────────────────
# Show the demo accounts on the login page. Only for development with the demo data (npm run db:seed).
SHOW_DEMO_ACCOUNTS="false"

# Optional: the address printed in the QR code on CS Form No. 6 (e.g. "https://mmh-leave.onrender.com").
# Leave it out on the LAN: the QR then uses the address the browser used, e.g. http://192.168.1.10:3000.
# APP_URL="https://mmh-leave.onrender.com"
